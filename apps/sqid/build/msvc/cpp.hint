#define DEFINE_OP_DESC(_TYPE, _NAME, _PATH, _GUID) const char *_TYPE::Name() { return _NAME; } const char *_TYPE::getName() const { return _NAME; } const char *_TYPE::Path() { return _PATH; } const char *_TYPE::getPath() const { return _PATH; } const GUID &_TYPE::ClassID() { static const GUID clsID = guidFromString( _GUID ); return clsID; } const GUID &_TYPE::getClassID() const { return _TYPE::ClassID(); }
